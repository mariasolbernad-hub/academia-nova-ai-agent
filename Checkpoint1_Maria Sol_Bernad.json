    {
      "parameters": {
        "sendTo": "mariasolbernad@gmail.com",
        "subject": "Academia Nova - Solicitud de escalamiento",
        "message": "=\n{{ `\n<h2>Academia Nova - Reporte de Escalamiento</h2>\n\n<p><b>Consulta del estudiante:</b><br>\n${$('01 - Recepción de consultas').first().json.chatInput}</p>\n\n<p><b>Respuesta del agente:</b><br>\n${$('02 - Agente IA de Preinscripciones').first().json.output.respuesta}</p>\n\n<p><b>Motivo de escalamiento:</b><br>\n${$('02 - Agente IA de Preinscripciones').first().json.output.motivo_escalamiento}</p>\n\n<p><b>Curso de interés:</b><br>\n${$('02 - Agente IA de Preinscripciones').first().json.output.curso_interes || 'No especificado'}</p>\n\n<p><b>Estado:</b> Escalado a soporte</p>\n<p><b>ID de ejecución:</b> ${$execution.id}</p>\n<p><b>Fecha:</b> ${$now.toFormat('dd/MM/yyyy HH:mm')}</p>\n\n<hr>\n\n<h3>Auditoría de herramientas</h3>\n\n<p><b>Herramientas utilizadas:</b></p>\n\n${$('02 - Agente IA de Preinscripciones').first().json.intermediateSteps?.length\n  ? $('02 - Agente IA de Preinscripciones').first().json.intermediateSteps.map(step => `\n    <p><b>Herramienta:</b> ${step.action?.tool || 'No identificada'}</p>\n    <p><b>Resultado:</b></p>\n    <pre style=\"white-space:pre-wrap;overflow-wrap:anywhere;\">${String(step.observation ?? 'Sin resultado registrado').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>\n  `).join('')\n  : '<p>No se utilizaron herramientas en esta ejecución.</p>'\n}\n` }}\n",
        "options": {}
      },
